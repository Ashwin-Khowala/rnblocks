    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@rnblocks/registry": "workspace:*",
    "@types/node": "^20.17.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  }
}
