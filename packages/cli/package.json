{
  "name": "@rnblocks/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "CLI to add React Native components and screens directly to your project",
  "license": "MIT",
  "author": "Ashwin Khowala",
  "homepage": "https://rnblocks.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashwin-Khowala/rnblocks.git",
    "directory": "packages/cli"
  },
  "bin": {
